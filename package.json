    "package:mac": "node scripts/package-macos.mjs"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/w3c-web-hid": "1.0.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "esbuild": "0.25.12",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
